{
  "name": "jesutobits-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=26.6.0"
  },
  "scripts": {
    "build:packages": "tsc -b && pnpm gen && pnpm build:runtime && pnpm build:guest",
    "build:runtime": "node scripts/build-runtime.mjs",
    "build:guest": "node scripts/build-guest.mjs",
    "fetch:sidecars": "node scripts/fetch-node.mjs",
    "dev": "pnpm build:packages && pnpm --filter @jesutobits/desktop tauri dev --config src-tauri/tauri.dev.conf.json",
    "dev:web": "node scripts/dev-web.mjs",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0 && prettier --check . && pnpm lint:rust",
    "lint:rust": "cargo fmt --manifest-path apps/desktop/src-tauri/Cargo.toml --check && cargo clippy --manifest-path apps/desktop/src-tauri/Cargo.toml --all-targets -- -D warnings",
    "format": "prettier --write .",
    "test": "tsc -b && pnpm build:runtime && vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @jesutobits/desktop test:e2e",
    "test:rust": "cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "gen": "tsc -b packages/protocol && node scripts/gen-protocol.mjs && node scripts/gen-allowlist.mjs",
    "gen:check": "pnpm gen && git diff --exit-code -- packages/protocol/generated apps/desktop/src-tauri/src/rpc_relay/allowlist.rs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  }
}
