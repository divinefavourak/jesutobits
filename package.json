{
  "name": "jesutobits-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=26.6.0"
  },
  "scripts": {
    "build:packages": "tsc -b && pnpm gen && pnpm build:runtime && pnpm build:guest",
    "build:runtime": "node scripts/build-runtime.mjs",
    "build:guest": "node scripts/build-guest.mjs",
    "build:extension": "pnpm --filter jesutobits build",
    "dev": "pnpm build:packages && pnpm build:extension && code --extensionDevelopmentPath=apps/vscode-extension",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "test": "tsc -b && pnpm build:runtime && vitest run",
    "test:watch": "vitest",
    "gen": "tsc -b packages/protocol && node scripts/gen-protocol.mjs",
    "gen:check": "pnpm gen && git diff --exit-code -- packages/protocol/generated"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  }
}
