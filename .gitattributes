# Normalise text to LF in the repository; check out with native endings.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Fixtures exercise line-ending preservation (ARCHITECTURE.md section 11): never convert.
fixtures/** -text

*.png binary
*.ico binary
*.lottie binary
*.wasm binary
