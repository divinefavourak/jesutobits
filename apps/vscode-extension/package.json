{
  "name": "jesutobits",
  "displayName": "Jesutobits",
  "description": "The Jesutobits agent: plans, edits, runs and verifies your project, with every action shown and permissioned.",
  "version": "0.3.0",
  "publisher": "jesutobits",
  "private": true,
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode the agent can read and answer but never edits files or runs commands."
    }
  },
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "jesutobits",
          "title": "Jesutobits",
          "icon": "media/jesutobits.svg"
        }
      ]
    },
    "views": {
      "jesutobits": [
        {
          "type": "webview",
          "id": "jesutobits.agent",
          "name": "Agent"
        }
      ],
      "explorer": [
        {
          "type": "webview",
          "id": "jesutobits.studio",
          "name": "Studio",
          "icon": "media/jesutobits.svg",
          "visibility": "visible",
          "initialSize": 2
        }
      ]
    },
    "commands": [
      {
        "command": "jesutobits.restartRuntime",
        "title": "Restart Agent Runtime",
        "category": "Jesutobits"
      },
      {
        "command": "jesutobits.showLog",
        "title": "Show Runtime Log",
        "category": "Jesutobits"
      },
      {
        "command": "jesutobits.openAgent",
        "title": "Open Agent",
        "category": "Jesutobits"
      },
      {
        "command": "jesutobits.connectOpenRouter",
        "title": "Sign In with OpenRouter",
        "category": "Jesutobits"
      },
      {
        "command": "jesutobits.setApiKey",
        "title": "Set OpenRouter API Key",
        "category": "Jesutobits"
      },
      {
        "command": "jesutobits.chooseModel",
        "title": "Choose Default Model",
        "category": "Jesutobits"
      },
      {
        "command": "jesutobits.openPreview",
        "title": "Open Preview",
        "category": "Jesutobits",
        "icon": "$(open-preview)"
      },
      {
        "command": "jesutobits.getStarted",
        "title": "Get Started",
        "category": "Jesutobits"
      },
      {
        "command": "jesutobits.hasApiKey",
        "title": "Check for an OpenRouter API Key",
        "category": "Jesutobits"
      },
      {
        "command": "jesutobits.compose",
        "title": "Put a Task in the Agent's Message Box",
        "category": "Jesutobits"
      },
      {
        "command": "jesutobits.useFreeModel",
        "title": "Use the Free Coding Model",
        "category": "Jesutobits"
      },
      {
        "command": "jesutobits.profile",
        "title": "Your Profile",
        "category": "Jesutobits"
      },
      {
        "command": "jesutobits.account",
        "title": "Your Account",
        "category": "Jesutobits"
      },
      {
        "command": "jesutobits.chooseProfilePicture",
        "title": "Choose Your Picture",
        "category": "Jesutobits"
      },
      {
        "command": "jesutobits.removeProfilePicture",
        "title": "Remove Your Picture",
        "category": "Jesutobits"
      },
      {
        "command": "jesutobits.signOut",
        "title": "Sign Out of OpenRouter",
        "category": "Jesutobits"
      },
      {
        "command": "jesutobits.newProject",
        "title": "New Project…",
        "category": "Jesutobits",
        "icon": "$(new-folder)"
      },
      {
        "command": "jesutobits.choosePolicyPreset",
        "title": "Choose Permission Level",
        "category": "Jesutobits"
      },
      {
        "command": "jesutobits.changeLook",
        "title": "Change the Look",
        "category": "Jesutobits",
        "icon": "$(symbol-color)"
      },
      {
        "command": "jesutobits.openLearning",
        "title": "Open the Learning Centre",
        "category": "Jesutobits",
        "icon": "$(book)"
      }
    ],
    "walkthroughs": [
      {
        "id": "jesutobits.start",
        "title": "Set up your co-builder",
        "description": "Connect a model provider and give the agent its first task.",
        "steps": [
          {
            "id": "apiKey",
            "title": "Connect OpenRouter",
            "description": "OpenRouter is one account for many AI models. Sign in and allow Jesutobits; OpenRouter makes a key for it, kept in your system's credential store.\n[Sign in with OpenRouter](command:jesutobits.connectOpenRouter)",
            "media": {
              "markdown": "media/walkthrough/api-key.md"
            },
            "completionEvents": [
              "onCommand:jesutobits.connectOpenRouter",
              "onCommand:jesutobits.setApiKey"
            ]
          },
          {
            "id": "model",
            "title": "Choose a default model",
            "description": "Pick the model new sessions use. Models that cannot use tools only work in Ask mode.\n[Choose model](command:jesutobits.chooseModel)",
            "media": {
              "markdown": "media/walkthrough/model.md"
            },
            "completionEvents": [
              "onSettingChanged:jesutobits.providers.openrouter.defaultModel"
            ]
          },
          {
            "id": "firstTask",
            "title": "Give the agent a task",
            "description": "Open a folder, then ask the agent to change something. You approve anything risky, every step shows in the timeline, and Revert turn undoes a turn's edits.\n[Open the agent](command:jesutobits.openAgent)",
            "media": {
              "markdown": "media/walkthrough/first-task.md"
            },
            "completionEvents": [
              "onView:jesutobits.agent"
            ]
          }
        ]
      }
    ],
    "configuration": {
      "title": "Jesutobits",
      "properties": {
        "jesutobits.providers.openrouter.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Use OpenRouter for the agent's model calls."
        },
        "jesutobits.providers.openrouter.profile": {
          "type": "string",
          "default": "default",
          "pattern": "^[a-z0-9-]{1,32}$",
          "description": "Which stored OpenRouter key to use. The key itself lives in the OS credential store, never in settings."
        },
        "jesutobits.providers.openrouter.defaultModel": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "markdownDescription": "Model for new agent sessions, for example `anthropic/claude-sonnet-5.5`. Run **Jesutobits: Choose Default Model** to pick from OpenRouter's list."
        },
        "jesutobits.providers.openrouter.dataCollection": {
          "type": "string",
          "enum": [
            "deny",
            "allow"
          ],
          "default": "deny",
          "description": "Whether OpenRouter may route to providers that keep or train on prompts."
        },
        "jesutobits.providers.openrouter.allowFallbacks": {
          "type": "boolean",
          "default": true,
          "description": "Let OpenRouter use another provider for the same model when the first is unavailable."
        },
        "jesutobits.agent.defaultPolicyPreset": {
          "type": "string",
          "enum": [
            "cautious",
            "balanced",
            "autonomous"
          ],
          "default": "balanced",
          "description": "How often the agent asks before acting, for projects without a preset of their own."
        },
        "jesutobits.profile.name": {
          "type": "string",
          "default": "",
          "maxLength": 60,
          "description": "What Jesutobits calls you, shown with your picture in the top bar. It stays on this computer. Empty uses your computer's user name."
        },
        "jesutobits.experience": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "new",
            "some",
            "pro",
            null
          ],
          "enumDescriptions": [
            "Just getting started",
            "Finding my feet",
            "I know my way around",
            ""
          ],
          "default": null,
          "description": "Where you are starting from, as chosen in the welcome popup."
        },
        "jesutobits.companion.skin": {
          "type": "string",
          "enum": [
            "buddy",
            "mark",
            "dot",
            "off"
          ],
          "enumDescriptions": [
            "Buddy, the co-builder: moves only while the agent works",
            "The pixel J mark",
            "A small status dot",
            "No companion; the agent's state still shows in words"
          ],
          "default": "buddy",
          "description": "How the companion beside the agent panel's header looks. It always shows the agent's real state."
        },
        "jesutobits.preview.showOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Open the preview tab in the middle when a folder opens. It waits for you to press Start; it never starts the project by itself."
        },
        "jesutobits.agent.limits.stepsPerTurn": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 40,
          "description": "Model steps per turn before the agent stops and asks."
        },
        "jesutobits.agent.limits.toolCallsPerTurn": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000,
          "default": 150,
          "description": "Tool calls per turn before the agent stops and asks."
        },
        "jesutobits.agent.limits.turnMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600,
          "default": 30,
          "description": "Minutes per turn before the agent stops and asks."
        },
        "jesutobits.agent.limits.costPerTurnUsd": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 1000,
          "default": 1,
          "description": "Model cost per turn, in US dollars, before the agent stops and asks."
        },
        "jesutobits.agent.limits.costPerSessionUsd": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 10000,
          "default": 5,
          "description": "Model cost per session, in US dollars, before the agent stops and asks."
        },
        "jesutobits.agent.limits.fixAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 3,
          "description": "Attempts to fix a failing check before the agent reports it."
        },
        "jesutobits.privacy.logModelTraffic": {
          "type": "boolean",
          "default": false,
          "description": "Log model requests and responses (secrets are always masked)."
        },
        "jesutobits.privacy.providerAttributionHeaders": {
          "type": "boolean",
          "default": false,
          "description": "Send Jesutobits' name to OpenRouter in attribution headers."
        }
      }
    },
    "themes": [
      {
        "id": "Lavender dusk",
        "label": "Lavender dusk",
        "uiTheme": "vs-dark",
        "path": "./themes/lavender-dusk.json"
      },
      {
        "id": "Matcha",
        "label": "Matcha",
        "uiTheme": "vs-dark",
        "path": "./themes/matcha.json"
      },
      {
        "id": "Ocean after hours",
        "label": "Ocean after hours",
        "uiTheme": "vs-dark",
        "path": "./themes/ocean-after-hours.json"
      },
      {
        "id": "Peach tea",
        "label": "Peach tea",
        "uiTheme": "vs-dark",
        "path": "./themes/peach-tea.json"
      },
      {
        "id": "Daydream",
        "label": "Daydream",
        "uiTheme": "vs",
        "path": "./themes/daydream.json"
      },
      {
        "id": "Paper & sage",
        "label": "Paper & sage",
        "uiTheme": "vs",
        "path": "./themes/paper-and-sage.json"
      }
    ],
    "configurationDefaults": {
      "workbench.colorTheme": "Lavender dusk",
      "workbench.preferredDarkColorTheme": "Lavender dusk",
      "workbench.preferredLightColorTheme": "Daydream",
      "workbench.secondarySideBar.defaultVisibility": "visible"
    },
    "menus": {
      "commandPalette": [
        {
          "command": "jesutobits.hasApiKey",
          "when": "false"
        },
        {
          "command": "jesutobits.compose",
          "when": "false"
        },
        {
          "command": "jesutobits.useFreeModel",
          "when": "false"
        },
        {
          "command": "jesutobits.profile",
          "when": "false"
        },
        {
          "command": "jesutobits.account",
          "when": "false"
        }
      ],
      "file/newFile": [
        {
          "command": "jesutobits.newProject",
          "group": "file"
        }
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs"
  },
  "dependencies": {
    "@jesutobits/protocol": "workspace:*",
    "@jesutobits/shared": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@jesutobits/runtime": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "1.140.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4"
  }
}
