{
  "$schema": "vscode://schemas/color-theme",
  "name": "Peach tea",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "foreground": "#fbefea",
    "descriptionForeground": "#b5a8a7",
    "disabledForeground": "#827677",
    "errorForeground": "#f0a2a8",
    "focusBorder": "#efb69e",
    "widget.border": "#fbefea1a",
    "widget.shadow": "#00000055",
    "selection.background": "#efb69e4d",
    "textLink.foreground": "#efb69e",
    "textLink.activeForeground": "#f1c1ad",
    "button.background": "#efb69e",
    "button.foreground": "#17161c",
    "button.hoverBackground": "#f1bfa9",
    "button.secondaryBackground": "#403338",
    "button.secondaryForeground": "#fbefea",
    "button.secondaryHoverBackground": "#4a3d42",
    "badge.background": "#efb69e",
    "badge.foreground": "#17161c",
    "progressBar.background": "#efb69e",
    "input.background": "#403338",
    "input.foreground": "#fbefea",
    "input.border": "#fbefea1a",
    "input.placeholderForeground": "#b5a8a7",
    "inputOption.activeBorder": "#efb69e",
    "dropdown.background": "#403338",
    "dropdown.border": "#fbefea1a",
    "checkbox.background": "#403338",
    "checkbox.border": "#fbefea1a",
    "titleBar.activeBackground": "#261c20",
    "titleBar.inactiveBackground": "#261c20",
    "titleBar.activeForeground": "#fbefea",
    "titleBar.border": "#fbefea1a",
    "menu.background": "#32252b",
    "menu.selectionBackground": "#efb69e29",
    "commandCenter.background": "#403338",
    "commandCenter.border": "#fbefea1a",
    "activityBar.background": "#261c20",
    "activityBar.foreground": "#efb69e",
    "activityBar.inactiveForeground": "#b5a8a7",
    "activityBar.activeBorder": "#efb69e",
    "activityBar.border": "#fbefea1a",
    "activityBarBadge.background": "#efb69e",
    "activityBarBadge.foreground": "#17161c",
    "sideBar.background": "#261c20",
    "sideBar.foreground": "#fbefea",
    "sideBar.border": "#fbefea1a",
    "sideBarTitle.foreground": "#b5a8a7",
    "sideBarSectionHeader.background": "#261c20",
    "sideBarSectionHeader.border": "#fbefea1a",
    "list.activeSelectionBackground": "#efb69e29",
    "list.activeSelectionForeground": "#fbefea",
    "list.inactiveSelectionBackground": "#efb69e1a",
    "list.hoverBackground": "#403338",
    "list.focusOutline": "#efb69e",
    "list.highlightForeground": "#efb69e",
    "editor.background": "#32252b",
    "editor.foreground": "#fbefea",
    "editor.lineHighlightBackground": "#fbefea0a",
    "editor.selectionBackground": "#efb69e47",
    "editor.inactiveSelectionBackground": "#efb69e24",
    "editorCursor.foreground": "#efb69e",
    "editorLineNumber.foreground": "#786c6e",
    "editorLineNumber.activeForeground": "#fbefea",
    "editorIndentGuide.background1": "#fbefea1a",
    "editorWidget.background": "#32252b",
    "editorWidget.border": "#fbefea1a",
    "editorGroup.border": "#fbefea1a",
    "editorGroupHeader.tabsBackground": "#261c20",
    "editorGroupHeader.tabsBorder": "#fbefea1a",
    "tab.activeBackground": "#32252b",
    "tab.activeForeground": "#fbefea",
    "tab.activeBorderTop": "#efb69e",
    "tab.inactiveBackground": "#261c20",
    "tab.inactiveForeground": "#b5a8a7",
    "tab.border": "#fbefea1a",
    "panel.background": "#261c20",
    "panel.border": "#fbefea1a",
    "panelTitle.activeForeground": "#fbefea",
    "panelTitle.activeBorder": "#efb69e",
    "panelTitle.inactiveForeground": "#b5a8a7",
    "statusBar.background": "#261c20",
    "statusBar.foreground": "#b5a8a7",
    "statusBar.border": "#fbefea1a",
    "statusBar.noFolderBackground": "#261c20",
    "statusBarItem.hoverBackground": "#403338",
    "statusBarItem.remoteBackground": "#efb69e",
    "statusBarItem.remoteForeground": "#17161c",
    "terminal.background": "#32252b",
    "terminal.foreground": "#fbefea",
    "scrollbarSlider.background": "#fbefea1a",
    "scrollbarSlider.hoverBackground": "#fbefea2e",
    "scrollbarSlider.activeBackground": "#efb69e66",
    "notifications.background": "#32252b",
    "notifications.border": "#fbefea1a",
    "quickInput.background": "#32252b",
    "quickInputList.focusBackground": "#efb69e29",
    "welcomePage.tileBackground": "#403338",
    "walkThrough.embeddedEditorBackground": "#403338",
    "gitDecoration.addedResourceForeground": "#bad599",
    "gitDecoration.modifiedResourceForeground": "#e2ca95",
    "gitDecoration.deletedResourceForeground": "#e4b5be",
    "testing.iconPassed": "#bad599",
    "editorWarning.foreground": "#e2ca95",
    "editorInfo.foreground": "#91c9ee"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#899b78", "fontStyle": "italic" }
    },
    {
      "scope": ["keyword", "storage", "storage.type", "keyword.operator.new"],
      "settings": { "foreground": "#c5b1f7" }
    },
    {
      "scope": ["string", "string.quoted", "markup.inline.raw"],
      "settings": { "foreground": "#bad599" }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character"],
      "settings": { "foreground": "#efb69e" }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": { "foreground": "#91c9ee" }
    },
    {
      "scope": ["entity.name.type", "support.type", "support.class", "entity.name.class"],
      "settings": { "foreground": "#e2ca95" }
    },
    {
      "scope": ["entity.name.tag", "support.class.component"],
      "settings": { "foreground": "#e4b5be" }
    },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#e2ca95" } },
    { "scope": ["variable", "meta.definition.variable"], "settings": { "foreground": "#fbefea" } },
    { "scope": ["markup.heading"], "settings": { "foreground": "#c5b1f7", "fontStyle": "bold" } }
  ]
}
