{
  "$schema": "vscode://schemas/color-theme",
  "name": "Lavender dusk",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "foreground": "#f2eff7",
    "descriptionForeground": "#a9a6ae",
    "disabledForeground": "#74727a",
    "errorForeground": "#f0a2a8",
    "focusBorder": "#c5b1f7",
    "widget.border": "#f2eff71a",
    "widget.shadow": "#00000055",
    "selection.background": "#c5b1f74d",
    "textLink.foreground": "#c5b1f7",
    "textLink.activeForeground": "#cebdf7",
    "button.background": "#c5b1f7",
    "button.foreground": "#17161c",
    "button.hoverBackground": "#ccbaf7",
    "button.secondaryBackground": "#2f2d35",
    "button.secondaryForeground": "#f2eff7",
    "button.secondaryHoverBackground": "#39373f",
    "badge.background": "#c5b1f7",
    "badge.foreground": "#17161c",
    "progressBar.background": "#c5b1f7",
    "input.background": "#2f2d35",
    "input.foreground": "#f2eff7",
    "input.border": "#f2eff71a",
    "input.placeholderForeground": "#a9a6ae",
    "inputOption.activeBorder": "#c5b1f7",
    "dropdown.background": "#2f2d35",
    "dropdown.border": "#f2eff71a",
    "checkbox.background": "#2f2d35",
    "checkbox.border": "#f2eff71a",
    "titleBar.activeBackground": "#17161c",
    "titleBar.inactiveBackground": "#17161c",
    "titleBar.activeForeground": "#f2eff7",
    "titleBar.border": "#f2eff71a",
    "menu.background": "#201e26",
    "menu.selectionBackground": "#c5b1f729",
    "commandCenter.background": "#2f2d35",
    "commandCenter.border": "#f2eff71a",
    "activityBar.background": "#17161c",
    "activityBar.foreground": "#c5b1f7",
    "activityBar.inactiveForeground": "#a9a6ae",
    "activityBar.activeBorder": "#c5b1f7",
    "activityBar.border": "#f2eff71a",
    "activityBarBadge.background": "#c5b1f7",
    "activityBarBadge.foreground": "#17161c",
    "sideBar.background": "#17161c",
    "sideBar.foreground": "#f2eff7",
    "sideBar.border": "#f2eff71a",
    "sideBarTitle.foreground": "#a9a6ae",
    "sideBarSectionHeader.background": "#17161c",
    "sideBarSectionHeader.border": "#f2eff71a",
    "list.activeSelectionBackground": "#c5b1f729",
    "list.activeSelectionForeground": "#f2eff7",
    "list.inactiveSelectionBackground": "#c5b1f71a",
    "list.hoverBackground": "#2f2d35",
    "list.focusOutline": "#c5b1f7",
    "list.highlightForeground": "#c5b1f7",
    "editor.background": "#201e26",
    "editor.foreground": "#f2eff7",
    "editor.lineHighlightBackground": "#f2eff70a",
    "editor.selectionBackground": "#c5b1f747",
    "editor.inactiveSelectionBackground": "#c5b1f724",
    "editorCursor.foreground": "#c5b1f7",
    "editorLineNumber.foreground": "#69676f",
    "editorLineNumber.activeForeground": "#f2eff7",
    "editorIndentGuide.background1": "#f2eff71a",
    "editorWidget.background": "#201e26",
    "editorWidget.border": "#f2eff71a",
    "editorGroup.border": "#f2eff71a",
    "editorGroupHeader.tabsBackground": "#17161c",
    "editorGroupHeader.tabsBorder": "#f2eff71a",
    "tab.activeBackground": "#201e26",
    "tab.activeForeground": "#f2eff7",
    "tab.activeBorderTop": "#c5b1f7",
    "tab.inactiveBackground": "#17161c",
    "tab.inactiveForeground": "#a9a6ae",
    "tab.border": "#f2eff71a",
    "panel.background": "#17161c",
    "panel.border": "#f2eff71a",
    "panelTitle.activeForeground": "#f2eff7",
    "panelTitle.activeBorder": "#c5b1f7",
    "panelTitle.inactiveForeground": "#a9a6ae",
    "statusBar.background": "#17161c",
    "statusBar.foreground": "#a9a6ae",
    "statusBar.border": "#f2eff71a",
    "statusBar.noFolderBackground": "#17161c",
    "statusBarItem.hoverBackground": "#2f2d35",
    "statusBarItem.remoteBackground": "#c5b1f7",
    "statusBarItem.remoteForeground": "#17161c",
    "terminal.background": "#201e26",
    "terminal.foreground": "#f2eff7",
    "scrollbarSlider.background": "#f2eff71a",
    "scrollbarSlider.hoverBackground": "#f2eff72e",
    "scrollbarSlider.activeBackground": "#c5b1f766",
    "notifications.background": "#201e26",
    "notifications.border": "#f2eff71a",
    "quickInput.background": "#201e26",
    "quickInputList.focusBackground": "#c5b1f729",
    "welcomePage.tileBackground": "#2f2d35",
    "walkThrough.embeddedEditorBackground": "#2f2d35",
    "gitDecoration.addedResourceForeground": "#bad599",
    "gitDecoration.modifiedResourceForeground": "#e2ca95",
    "gitDecoration.deletedResourceForeground": "#e4b5be",
    "testing.iconPassed": "#bad599",
    "editorWarning.foreground": "#e2ca95",
    "editorInfo.foreground": "#91c9ee"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#899b78", "fontStyle": "italic" }
    },
    {
      "scope": ["keyword", "storage", "storage.type", "keyword.operator.new"],
      "settings": { "foreground": "#c5b1f7" }
    },
    {
      "scope": ["string", "string.quoted", "markup.inline.raw"],
      "settings": { "foreground": "#bad599" }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character"],
      "settings": { "foreground": "#efb69e" }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": { "foreground": "#91c9ee" }
    },
    {
      "scope": ["entity.name.type", "support.type", "support.class", "entity.name.class"],
      "settings": { "foreground": "#e2ca95" }
    },
    {
      "scope": ["entity.name.tag", "support.class.component"],
      "settings": { "foreground": "#e4b5be" }
    },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#e2ca95" } },
    { "scope": ["variable", "meta.definition.variable"], "settings": { "foreground": "#f2eff7" } },
    { "scope": ["markup.heading"], "settings": { "foreground": "#c5b1f7", "fontStyle": "bold" } }
  ]
}
