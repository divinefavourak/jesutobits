{
  "$schema": "vscode://schemas/color-theme",
  "name": "Paper & sage",
  "type": "light",
  "semanticHighlighting": true,
  "colors": {
    "foreground": "#303c2b",
    "descriptionForeground": "#777f72",
    "disabledForeground": "#a9afa4",
    "errorForeground": "#b4434d",
    "focusBorder": "#537638",
    "widget.border": "#303c2b1a",
    "widget.shadow": "#3322441a",
    "selection.background": "#5376384d",
    "textLink.foreground": "#537638",
    "textLink.activeForeground": "#4c6a35",
    "button.background": "#537638",
    "button.foreground": "#ffffff",
    "button.hoverBackground": "#4e6d36",
    "button.secondaryBackground": "#eceee7",
    "button.secondaryForeground": "#303c2b",
    "button.secondaryHoverBackground": "#e2e4dd",
    "badge.background": "#537638",
    "badge.foreground": "#ffffff",
    "progressBar.background": "#537638",
    "input.background": "#eceee7",
    "input.foreground": "#303c2b",
    "input.border": "#303c2b1a",
    "input.placeholderForeground": "#777f72",
    "inputOption.activeBorder": "#537638",
    "dropdown.background": "#eceee7",
    "dropdown.border": "#303c2b1a",
    "checkbox.background": "#eceee7",
    "checkbox.border": "#303c2b1a",
    "titleBar.activeBackground": "#eeefe7",
    "titleBar.inactiveBackground": "#eeefe7",
    "titleBar.activeForeground": "#303c2b",
    "titleBar.border": "#303c2b1a",
    "menu.background": "#fafbf5",
    "menu.selectionBackground": "#53763824",
    "commandCenter.background": "#eceee7",
    "commandCenter.border": "#303c2b1a",
    "activityBar.background": "#eeefe7",
    "activityBar.foreground": "#537638",
    "activityBar.inactiveForeground": "#777f72",
    "activityBar.activeBorder": "#537638",
    "activityBar.border": "#303c2b1a",
    "activityBarBadge.background": "#537638",
    "activityBarBadge.foreground": "#ffffff",
    "sideBar.background": "#eeefe7",
    "sideBar.foreground": "#303c2b",
    "sideBar.border": "#303c2b1a",
    "sideBarTitle.foreground": "#777f72",
    "sideBarSectionHeader.background": "#eeefe7",
    "sideBarSectionHeader.border": "#303c2b1a",
    "list.activeSelectionBackground": "#53763824",
    "list.activeSelectionForeground": "#303c2b",
    "list.inactiveSelectionBackground": "#5376381a",
    "list.hoverBackground": "#eceee7",
    "list.focusOutline": "#537638",
    "list.highlightForeground": "#537638",
    "editor.background": "#fafbf5",
    "editor.foreground": "#303c2b",
    "editor.lineHighlightBackground": "#303c2b0a",
    "editor.selectionBackground": "#53763847",
    "editor.inactiveSelectionBackground": "#53763824",
    "editorCursor.foreground": "#537638",
    "editorLineNumber.foreground": "#b3b8ae",
    "editorLineNumber.activeForeground": "#303c2b",
    "editorIndentGuide.background1": "#303c2b1a",
    "editorWidget.background": "#fafbf5",
    "editorWidget.border": "#303c2b1a",
    "editorGroup.border": "#303c2b1a",
    "editorGroupHeader.tabsBackground": "#eeefe7",
    "editorGroupHeader.tabsBorder": "#303c2b1a",
    "tab.activeBackground": "#fafbf5",
    "tab.activeForeground": "#303c2b",
    "tab.activeBorderTop": "#537638",
    "tab.inactiveBackground": "#eeefe7",
    "tab.inactiveForeground": "#777f72",
    "tab.border": "#303c2b1a",
    "panel.background": "#eeefe7",
    "panel.border": "#303c2b1a",
    "panelTitle.activeForeground": "#303c2b",
    "panelTitle.activeBorder": "#537638",
    "panelTitle.inactiveForeground": "#777f72",
    "statusBar.background": "#eeefe7",
    "statusBar.foreground": "#777f72",
    "statusBar.border": "#303c2b1a",
    "statusBar.noFolderBackground": "#eeefe7",
    "statusBarItem.hoverBackground": "#eceee7",
    "statusBarItem.remoteBackground": "#537638",
    "statusBarItem.remoteForeground": "#ffffff",
    "terminal.background": "#fafbf5",
    "terminal.foreground": "#303c2b",
    "scrollbarSlider.background": "#303c2b1a",
    "scrollbarSlider.hoverBackground": "#303c2b2e",
    "scrollbarSlider.activeBackground": "#53763866",
    "notifications.background": "#fafbf5",
    "notifications.border": "#303c2b1a",
    "quickInput.background": "#fafbf5",
    "quickInputList.focusBackground": "#53763824",
    "welcomePage.tileBackground": "#eceee7",
    "walkThrough.embeddedEditorBackground": "#eceee7",
    "gitDecoration.addedResourceForeground": "#537638",
    "gitDecoration.modifiedResourceForeground": "#8a6a1f",
    "gitDecoration.deletedResourceForeground": "#a24d68",
    "testing.iconPassed": "#537638",
    "editorWarning.foreground": "#8a6a1f",
    "editorInfo.foreground": "#2f6f9f"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#7d8a6c", "fontStyle": "italic" }
    },
    {
      "scope": ["keyword", "storage", "storage.type", "keyword.operator.new"],
      "settings": { "foreground": "#7652af" }
    },
    {
      "scope": ["string", "string.quoted", "markup.inline.raw"],
      "settings": { "foreground": "#537638" }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character"],
      "settings": { "foreground": "#a65f3f" }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": { "foreground": "#2f6f9f" }
    },
    {
      "scope": ["entity.name.type", "support.type", "support.class", "entity.name.class"],
      "settings": { "foreground": "#8a6a1f" }
    },
    {
      "scope": ["entity.name.tag", "support.class.component"],
      "settings": { "foreground": "#a24d68" }
    },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#8a6a1f" } },
    { "scope": ["variable", "meta.definition.variable"], "settings": { "foreground": "#303c2b" } },
    { "scope": ["markup.heading"], "settings": { "foreground": "#7652af", "fontStyle": "bold" } }
  ]
}
