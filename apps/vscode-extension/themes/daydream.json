{
  "$schema": "vscode://schemas/color-theme",
  "name": "Daydream",
  "type": "light",
  "semanticHighlighting": true,
  "colors": {
    "foreground": "#332b40",
    "descriptionForeground": "#797382",
    "disabledForeground": "#aaa6b1",
    "errorForeground": "#b4434d",
    "focusBorder": "#7652af",
    "widget.border": "#332b401a",
    "widget.shadow": "#3322441a",
    "selection.background": "#7652af4d",
    "textLink.foreground": "#7652af",
    "textLink.activeForeground": "#694a99",
    "button.background": "#7652af",
    "button.foreground": "#ffffff",
    "button.hoverBackground": "#6c4c9e",
    "button.secondaryBackground": "#eceaf0",
    "button.secondaryForeground": "#332b40",
    "button.secondaryHoverBackground": "#e2dfe6",
    "badge.background": "#7652af",
    "badge.foreground": "#ffffff",
    "progressBar.background": "#7652af",
    "input.background": "#eceaf0",
    "input.foreground": "#332b40",
    "input.border": "#332b401a",
    "input.placeholderForeground": "#797382",
    "inputOption.activeBorder": "#7652af",
    "dropdown.background": "#eceaf0",
    "dropdown.border": "#332b401a",
    "checkbox.background": "#eceaf0",
    "checkbox.border": "#332b401a",
    "titleBar.activeBackground": "#eeebf4",
    "titleBar.inactiveBackground": "#eeebf4",
    "titleBar.activeForeground": "#332b40",
    "titleBar.border": "#332b401a",
    "menu.background": "#faf8fd",
    "menu.selectionBackground": "#7652af24",
    "commandCenter.background": "#eceaf0",
    "commandCenter.border": "#332b401a",
    "activityBar.background": "#eeebf4",
    "activityBar.foreground": "#7652af",
    "activityBar.inactiveForeground": "#797382",
    "activityBar.activeBorder": "#7652af",
    "activityBar.border": "#332b401a",
    "activityBarBadge.background": "#7652af",
    "activityBarBadge.foreground": "#ffffff",
    "sideBar.background": "#eeebf4",
    "sideBar.foreground": "#332b40",
    "sideBar.border": "#332b401a",
    "sideBarTitle.foreground": "#797382",
    "sideBarSectionHeader.background": "#eeebf4",
    "sideBarSectionHeader.border": "#332b401a",
    "list.activeSelectionBackground": "#7652af24",
    "list.activeSelectionForeground": "#332b40",
    "list.inactiveSelectionBackground": "#7652af1a",
    "list.hoverBackground": "#eceaf0",
    "list.focusOutline": "#7652af",
    "list.highlightForeground": "#7652af",
    "editor.background": "#faf8fd",
    "editor.foreground": "#332b40",
    "editor.lineHighlightBackground": "#332b400a",
    "editor.selectionBackground": "#7652af47",
    "editor.inactiveSelectionBackground": "#7652af24",
    "editorCursor.foreground": "#7652af",
    "editorLineNumber.foreground": "#b4b0bb",
    "editorLineNumber.activeForeground": "#332b40",
    "editorIndentGuide.background1": "#332b401a",
    "editorWidget.background": "#faf8fd",
    "editorWidget.border": "#332b401a",
    "editorGroup.border": "#332b401a",
    "editorGroupHeader.tabsBackground": "#eeebf4",
    "editorGroupHeader.tabsBorder": "#332b401a",
    "tab.activeBackground": "#faf8fd",
    "tab.activeForeground": "#332b40",
    "tab.activeBorderTop": "#7652af",
    "tab.inactiveBackground": "#eeebf4",
    "tab.inactiveForeground": "#797382",
    "tab.border": "#332b401a",
    "panel.background": "#eeebf4",
    "panel.border": "#332b401a",
    "panelTitle.activeForeground": "#332b40",
    "panelTitle.activeBorder": "#7652af",
    "panelTitle.inactiveForeground": "#797382",
    "statusBar.background": "#eeebf4",
    "statusBar.foreground": "#797382",
    "statusBar.border": "#332b401a",
    "statusBar.noFolderBackground": "#eeebf4",
    "statusBarItem.hoverBackground": "#eceaf0",
    "statusBarItem.remoteBackground": "#7652af",
    "statusBarItem.remoteForeground": "#ffffff",
    "terminal.background": "#faf8fd",
    "terminal.foreground": "#332b40",
    "scrollbarSlider.background": "#332b401a",
    "scrollbarSlider.hoverBackground": "#332b402e",
    "scrollbarSlider.activeBackground": "#7652af66",
    "notifications.background": "#faf8fd",
    "notifications.border": "#332b401a",
    "quickInput.background": "#faf8fd",
    "quickInputList.focusBackground": "#7652af24",
    "welcomePage.tileBackground": "#eceaf0",
    "walkThrough.embeddedEditorBackground": "#eceaf0",
    "gitDecoration.addedResourceForeground": "#537638",
    "gitDecoration.modifiedResourceForeground": "#8a6a1f",
    "gitDecoration.deletedResourceForeground": "#a24d68",
    "testing.iconPassed": "#537638",
    "editorWarning.foreground": "#8a6a1f",
    "editorInfo.foreground": "#2f6f9f"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#7d8a6c", "fontStyle": "italic" }
    },
    {
      "scope": ["keyword", "storage", "storage.type", "keyword.operator.new"],
      "settings": { "foreground": "#7652af" }
    },
    {
      "scope": ["string", "string.quoted", "markup.inline.raw"],
      "settings": { "foreground": "#537638" }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character"],
      "settings": { "foreground": "#a65f3f" }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": { "foreground": "#2f6f9f" }
    },
    {
      "scope": ["entity.name.type", "support.type", "support.class", "entity.name.class"],
      "settings": { "foreground": "#8a6a1f" }
    },
    {
      "scope": ["entity.name.tag", "support.class.component"],
      "settings": { "foreground": "#a24d68" }
    },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#8a6a1f" } },
    { "scope": ["variable", "meta.definition.variable"], "settings": { "foreground": "#332b40" } },
    { "scope": ["markup.heading"], "settings": { "foreground": "#7652af", "fontStyle": "bold" } }
  ]
}
