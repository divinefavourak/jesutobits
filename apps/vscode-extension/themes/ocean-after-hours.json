{
  "$schema": "vscode://schemas/color-theme",
  "name": "Ocean after hours",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "foreground": "#ecf2fc",
    "descriptionForeground": "#a3acb8",
    "disabledForeground": "#6f7987",
    "errorForeground": "#f0a2a8",
    "focusBorder": "#91c9ee",
    "widget.border": "#ecf2fc1a",
    "widget.shadow": "#00000055",
    "selection.background": "#91c9ee4d",
    "textLink.foreground": "#91c9ee",
    "textLink.activeForeground": "#a3d1f1",
    "button.background": "#91c9ee",
    "button.foreground": "#17161c",
    "button.hoverBackground": "#9fcff0",
    "button.secondaryBackground": "#2b3747",
    "button.secondaryForeground": "#ecf2fc",
    "button.secondaryHoverBackground": "#354150",
    "badge.background": "#91c9ee",
    "badge.foreground": "#17161c",
    "progressBar.background": "#91c9ee",
    "input.background": "#2b3747",
    "input.foreground": "#ecf2fc",
    "input.border": "#ecf2fc1a",
    "input.placeholderForeground": "#a3acb8",
    "inputOption.activeBorder": "#91c9ee",
    "dropdown.background": "#2b3747",
    "dropdown.border": "#ecf2fc1a",
    "checkbox.background": "#2b3747",
    "checkbox.border": "#ecf2fc1a",
    "titleBar.activeBackground": "#121d2a",
    "titleBar.inactiveBackground": "#121d2a",
    "titleBar.activeForeground": "#ecf2fc",
    "titleBar.border": "#ecf2fc1a",
    "menu.background": "#1c2939",
    "menu.selectionBackground": "#91c9ee29",
    "commandCenter.background": "#2b3747",
    "commandCenter.border": "#ecf2fc1a",
    "activityBar.background": "#121d2a",
    "activityBar.foreground": "#91c9ee",
    "activityBar.inactiveForeground": "#a3acb8",
    "activityBar.activeBorder": "#91c9ee",
    "activityBar.border": "#ecf2fc1a",
    "activityBarBadge.background": "#91c9ee",
    "activityBarBadge.foreground": "#17161c",
    "sideBar.background": "#121d2a",
    "sideBar.foreground": "#ecf2fc",
    "sideBar.border": "#ecf2fc1a",
    "sideBarTitle.foreground": "#a3acb8",
    "sideBarSectionHeader.background": "#121d2a",
    "sideBarSectionHeader.border": "#ecf2fc1a",
    "list.activeSelectionBackground": "#91c9ee29",
    "list.activeSelectionForeground": "#ecf2fc",
    "list.inactiveSelectionBackground": "#91c9ee1a",
    "list.hoverBackground": "#2b3747",
    "list.focusOutline": "#91c9ee",
    "list.highlightForeground": "#91c9ee",
    "editor.background": "#1c2939",
    "editor.foreground": "#ecf2fc",
    "editor.lineHighlightBackground": "#ecf2fc0a",
    "editor.selectionBackground": "#91c9ee47",
    "editor.inactiveSelectionBackground": "#91c9ee24",
    "editorCursor.foreground": "#91c9ee",
    "editorLineNumber.foreground": "#656f7d",
    "editorLineNumber.activeForeground": "#ecf2fc",
    "editorIndentGuide.background1": "#ecf2fc1a",
    "editorWidget.background": "#1c2939",
    "editorWidget.border": "#ecf2fc1a",
    "editorGroup.border": "#ecf2fc1a",
    "editorGroupHeader.tabsBackground": "#121d2a",
    "editorGroupHeader.tabsBorder": "#ecf2fc1a",
    "tab.activeBackground": "#1c2939",
    "tab.activeForeground": "#ecf2fc",
    "tab.activeBorderTop": "#91c9ee",
    "tab.inactiveBackground": "#121d2a",
    "tab.inactiveForeground": "#a3acb8",
    "tab.border": "#ecf2fc1a",
    "panel.background": "#121d2a",
    "panel.border": "#ecf2fc1a",
    "panelTitle.activeForeground": "#ecf2fc",
    "panelTitle.activeBorder": "#91c9ee",
    "panelTitle.inactiveForeground": "#a3acb8",
    "statusBar.background": "#121d2a",
    "statusBar.foreground": "#a3acb8",
    "statusBar.border": "#ecf2fc1a",
    "statusBar.noFolderBackground": "#121d2a",
    "statusBarItem.hoverBackground": "#2b3747",
    "statusBarItem.remoteBackground": "#91c9ee",
    "statusBarItem.remoteForeground": "#17161c",
    "terminal.background": "#1c2939",
    "terminal.foreground": "#ecf2fc",
    "scrollbarSlider.background": "#ecf2fc1a",
    "scrollbarSlider.hoverBackground": "#ecf2fc2e",
    "scrollbarSlider.activeBackground": "#91c9ee66",
    "notifications.background": "#1c2939",
    "notifications.border": "#ecf2fc1a",
    "quickInput.background": "#1c2939",
    "quickInputList.focusBackground": "#91c9ee29",
    "welcomePage.tileBackground": "#2b3747",
    "walkThrough.embeddedEditorBackground": "#2b3747",
    "gitDecoration.addedResourceForeground": "#bad599",
    "gitDecoration.modifiedResourceForeground": "#e2ca95",
    "gitDecoration.deletedResourceForeground": "#e4b5be",
    "testing.iconPassed": "#bad599",
    "editorWarning.foreground": "#e2ca95",
    "editorInfo.foreground": "#91c9ee"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#899b78", "fontStyle": "italic" }
    },
    {
      "scope": ["keyword", "storage", "storage.type", "keyword.operator.new"],
      "settings": { "foreground": "#c5b1f7" }
    },
    {
      "scope": ["string", "string.quoted", "markup.inline.raw"],
      "settings": { "foreground": "#bad599" }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character"],
      "settings": { "foreground": "#efb69e" }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": { "foreground": "#91c9ee" }
    },
    {
      "scope": ["entity.name.type", "support.type", "support.class", "entity.name.class"],
      "settings": { "foreground": "#e2ca95" }
    },
    {
      "scope": ["entity.name.tag", "support.class.component"],
      "settings": { "foreground": "#e4b5be" }
    },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#e2ca95" } },
    { "scope": ["variable", "meta.definition.variable"], "settings": { "foreground": "#ecf2fc" } },
    { "scope": ["markup.heading"], "settings": { "foreground": "#c5b1f7", "fontStyle": "bold" } }
  ]
}
