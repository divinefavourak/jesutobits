{
  "$schema": "vscode://schemas/color-theme",
  "name": "Matcha",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "foreground": "#edf4e9",
    "descriptionForeground": "#a5aea4",
    "disabledForeground": "#727c73",
    "errorForeground": "#f0a2a8",
    "focusBorder": "#bad599",
    "widget.border": "#edf4e91a",
    "widget.shadow": "#00000055",
    "selection.background": "#bad5994d",
    "textLink.foreground": "#bad599",
    "textLink.activeForeground": "#c4dba9",
    "button.background": "#bad599",
    "button.foreground": "#17161c",
    "button.hoverBackground": "#c2daa5",
    "button.secondaryBackground": "#2e3a33",
    "button.secondaryForeground": "#edf4e9",
    "button.secondaryHoverBackground": "#39443d",
    "badge.background": "#bad599",
    "badge.foreground": "#17161c",
    "progressBar.background": "#bad599",
    "input.background": "#2e3a33",
    "input.foreground": "#edf4e9",
    "input.border": "#edf4e91a",
    "input.placeholderForeground": "#a5aea4",
    "inputOption.activeBorder": "#bad599",
    "dropdown.background": "#2e3a33",
    "dropdown.border": "#edf4e91a",
    "checkbox.background": "#2e3a33",
    "checkbox.border": "#edf4e91a",
    "titleBar.activeBackground": "#17201c",
    "titleBar.inactiveBackground": "#17201c",
    "titleBar.activeForeground": "#edf4e9",
    "titleBar.border": "#edf4e91a",
    "menu.background": "#202c25",
    "menu.selectionBackground": "#bad59929",
    "commandCenter.background": "#2e3a33",
    "commandCenter.border": "#edf4e91a",
    "activityBar.background": "#17201c",
    "activityBar.foreground": "#bad599",
    "activityBar.inactiveForeground": "#a5aea4",
    "activityBar.activeBorder": "#bad599",
    "activityBar.border": "#edf4e91a",
    "activityBarBadge.background": "#bad599",
    "activityBarBadge.foreground": "#17161c",
    "sideBar.background": "#17201c",
    "sideBar.foreground": "#edf4e9",
    "sideBar.border": "#edf4e91a",
    "sideBarTitle.foreground": "#a5aea4",
    "sideBarSectionHeader.background": "#17201c",
    "sideBarSectionHeader.border": "#edf4e91a",
    "list.activeSelectionBackground": "#bad59929",
    "list.activeSelectionForeground": "#edf4e9",
    "list.inactiveSelectionBackground": "#bad5991a",
    "list.hoverBackground": "#2e3a33",
    "list.focusOutline": "#bad599",
    "list.highlightForeground": "#bad599",
    "editor.background": "#202c25",
    "editor.foreground": "#edf4e9",
    "editor.lineHighlightBackground": "#edf4e90a",
    "editor.selectionBackground": "#bad59947",
    "editor.inactiveSelectionBackground": "#bad59924",
    "editorCursor.foreground": "#bad599",
    "editorLineNumber.foreground": "#68726a",
    "editorLineNumber.activeForeground": "#edf4e9",
    "editorIndentGuide.background1": "#edf4e91a",
    "editorWidget.background": "#202c25",
    "editorWidget.border": "#edf4e91a",
    "editorGroup.border": "#edf4e91a",
    "editorGroupHeader.tabsBackground": "#17201c",
    "editorGroupHeader.tabsBorder": "#edf4e91a",
    "tab.activeBackground": "#202c25",
    "tab.activeForeground": "#edf4e9",
    "tab.activeBorderTop": "#bad599",
    "tab.inactiveBackground": "#17201c",
    "tab.inactiveForeground": "#a5aea4",
    "tab.border": "#edf4e91a",
    "panel.background": "#17201c",
    "panel.border": "#edf4e91a",
    "panelTitle.activeForeground": "#edf4e9",
    "panelTitle.activeBorder": "#bad599",
    "panelTitle.inactiveForeground": "#a5aea4",
    "statusBar.background": "#17201c",
    "statusBar.foreground": "#a5aea4",
    "statusBar.border": "#edf4e91a",
    "statusBar.noFolderBackground": "#17201c",
    "statusBarItem.hoverBackground": "#2e3a33",
    "statusBarItem.remoteBackground": "#bad599",
    "statusBarItem.remoteForeground": "#17161c",
    "terminal.background": "#202c25",
    "terminal.foreground": "#edf4e9",
    "scrollbarSlider.background": "#edf4e91a",
    "scrollbarSlider.hoverBackground": "#edf4e92e",
    "scrollbarSlider.activeBackground": "#bad59966",
    "notifications.background": "#202c25",
    "notifications.border": "#edf4e91a",
    "quickInput.background": "#202c25",
    "quickInputList.focusBackground": "#bad59929",
    "welcomePage.tileBackground": "#2e3a33",
    "walkThrough.embeddedEditorBackground": "#2e3a33",
    "gitDecoration.addedResourceForeground": "#bad599",
    "gitDecoration.modifiedResourceForeground": "#e2ca95",
    "gitDecoration.deletedResourceForeground": "#e4b5be",
    "testing.iconPassed": "#bad599",
    "editorWarning.foreground": "#e2ca95",
    "editorInfo.foreground": "#91c9ee"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#899b78", "fontStyle": "italic" }
    },
    {
      "scope": ["keyword", "storage", "storage.type", "keyword.operator.new"],
      "settings": { "foreground": "#c5b1f7" }
    },
    {
      "scope": ["string", "string.quoted", "markup.inline.raw"],
      "settings": { "foreground": "#bad599" }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character"],
      "settings": { "foreground": "#efb69e" }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": { "foreground": "#91c9ee" }
    },
    {
      "scope": ["entity.name.type", "support.type", "support.class", "entity.name.class"],
      "settings": { "foreground": "#e2ca95" }
    },
    {
      "scope": ["entity.name.tag", "support.class.component"],
      "settings": { "foreground": "#e4b5be" }
    },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#e2ca95" } },
    { "scope": ["variable", "meta.definition.variable"], "settings": { "foreground": "#edf4e9" } },
    { "scope": ["markup.heading"], "settings": { "foreground": "#c5b1f7", "fontStyle": "bold" } }
  ]
}
